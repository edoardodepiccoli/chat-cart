<div id="chat-cart-root" data-locale="{{ request.locale.iso_code }}" data-country="{{ localization.country.iso_code }}" data-page-type="{{ request.page_type }}" data-product-handle="{{ product.handle | escape }}" data-collection-handle="{{ collection.handle | escape }}" data-search-terms="{{ search.terms | escape }}" data-hide-selector="{{ block.settings.hide_selector | escape }}" data-cart-selectors="{{ block.settings.cart_selectors | escape }}"></div>

<link rel="stylesheet" href="{{ 'chat-widget.css' | asset_url }}">
<script src="{{ 'chat-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Chat Cart",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "hide_selector",
      "label": "Hide chat button when these elements cover it",
      "info": "Comma-separated CSS selectors (e.g. .menu-drawer, .sticky-add-to-cart). The chat button hides while any of them is visible and overlaps it. An open chat is never hidden."
    },
    {
      "type": "text",
      "id": "cart_selectors",
      "label": "Cart elements to refresh",
      "info": "Only needed for themes other than Horizon and Dawn. Comma-separated CSS selectors of the cart count and cart drawer (e.g. .cart-count, #cart-drawer). They are refreshed after the shopper changes the cart from the chat."
    }
  ]
}
{% endschema %}
