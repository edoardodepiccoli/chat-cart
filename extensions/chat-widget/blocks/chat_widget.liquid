{%- assign widget_theme = app.metafields.chat_cart.theme.value -%}
{%- if widget_theme.fontUrls.size > 0 -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- for font_url in widget_theme.fontUrls -%}
    <link rel="stylesheet" href="{{ font_url | escape }}">
  {%- endfor -%}
{%- endif -%}
<div id="chat-cart-root" style="{{ widget_theme.style | escape }}"></div>

<link rel="stylesheet" href="{{ 'chat-widget.css' | asset_url }}">
<script src="{{ 'chat-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Chat Cart",
  "target": "body",
  "settings": []
}
{% endschema %}
